{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "children": [
            {
              "definition": "tile/column",
              "meta": {
                "if": "{!$attrs.hasEntries}"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "meta": {
                    "forEach": "{!$attrs.entries}",
                    "forItem": "$entry"
                  },
                  "children": [
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$entry.player}"
                      }
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!FORMATNUMBER($entry.score)}"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/button",
              "attributes": {
                "label": "Open the board",
                "actions": {
                  "click": [
                    {
                      "definition": "action/openLink",
                      "attributes": {
                        "url": "https://example.com"
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
